# Which generation backend to use: mock | anthropic | watsonx | openrouter
LLM_PROVIDER=mock

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Optional: override the Claude model (default: claude-3-5-sonnet-20241022)
ANTHROPIC_MODEL=

# Only needed if LLM_PROVIDER=watsonx
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# Optional: override endpoint and model
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# Only needed if LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Optional: override the model (default is a free Llama 3.1 8B)
# Browse models at https://openrouter.ai/models
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
